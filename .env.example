# Generate a NEW key as described in docs/DEVELOPMENT.md. Never reuse a key from Git.
DJANGO_SECRET_KEY=
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
DB_ENGINE=postgresql
POSTGRES_DB=grocery_app_dev
POSTGRES_USER=grocery_app_dev
POSTGRES_PASSWORD=
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
# Explicit SQLite fallback, only for local development/tests:
# DB_ENGINE=sqlite
# SQLITE_PATH=/absolute/path/to/a/new/local-development.sqlite3
